@startuml
!theme plain

title Package Diagram - Asymptotic AI Agent Financial Gateway

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam defaultFontName "Arial"

package "presentation" as presentation #E0F2FE {
  package "gateway api" as gateway_api
  package "admin api" as admin_api
  package "payment callback" as payment_callback
}

package "application" as application #FEF3C7 {
  package "identity" as identity
  package "organization structure" as organization_structure
  package "agent" as agent
  package "apikey" as apikey
  package "policy" as policy
  package "ledger" as ledger
  package "provider catalog" as provider_catalog
  package "payment" as payment
  package "reporting" as reporting
}

package "domain" as domain #DCFCE7 {
  package "organization" as organization_domain
  package "agent model" as agent_domain
  package "financial model" as financial_domain
  package "provider model" as provider_domain
  package "trace model" as trace_domain
}

package "infrastructure" as infrastructure #F3E8FF {
  package "persistence" as persistence
  package "provider adapter" as provider_adapter
  package "payment adapter" as payment_adapter
  package "security" as security
}

gateway_api ..> apikey
