  class ReportingService
}

package "Domain Entities" #DCFCE7 {
  class Organization
  class User
  class Team
  class TeamMembership
  class DeveloperProfile
  class Agent
  class APIKey
  class Wallet
  class BudgetPolicy
  class BudgetAllocation
  class BudgetReservation
  class FinancialTransaction
  class LedgerEntry
  class PaymentTransaction
  class AIProvider
  class AIModel
  class PricingPolicy
