@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "AI Agent" as Agent
actor "Nhà cung cấp\ndịch vụ AI" as Provider

rectangle "Thực hiện yêu cầu AI qua Gateway" {
  usecase "Thực hiện yêu cầu AI\nqua Gateway" as UC01
}

Agent -- UC01
UC01 -- Provider
@enduml
