@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Người dùng\ntổ chức" as OrgUser
actor "Quản trị viên\ntổ chức" as OrgAdmin
actor "Lập trình viên" as Dev

OrgAdmin --|> OrgUser
Dev --|> OrgUser

rectangle "AI Agent Financial Gateway" {
  usecase "UC06.1\nXem tổng quan\nmức sử dụng" as UC061
  usecase "UC06.2\nTra cứu lịch sử\ngiao dịch" as UC062
  usecase "UC06.3\nXem chi tiết\ngiao dịch" as UC063
  usecase "UC06.4\nLọc dữ liệu\ntheo thời gian" as UC064
  usecase "UC06.5\nXuất báo cáo" as UC065
}

OrgUser -- UC061
OrgUser -- UC062

UC063 ..> UC062 : <<extend>>
UC064 ..> UC062 : <<extend>>
UC065 ..> UC062 : <<extend>>
@enduml
