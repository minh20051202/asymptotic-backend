@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "AI Agent" as Agent
actor "Nhà cung cấp\ndịch vụ AI" as Provider

rectangle "AI Agent Financial Gateway" {
  usecase "UC01\nThực hiện yêu cầu AI" as UC01
}

Agent -- UC01
Provider -- UC01

@enduml
