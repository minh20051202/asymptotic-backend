@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Quản trị viên\ntổ chức" as OrgAdmin
actor "Nhà cung cấp\nthanh toán" as PaymentProvider

rectangle "AI Agent Financial Gateway" {
  usecase "UC02\nNạp tiền vào ví tổ chức" as UC02
}

OrgAdmin -- UC02
UC02 -- PaymentProvider
@enduml
