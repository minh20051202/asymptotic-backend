@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Lập trình viên" as Dev

rectangle "AI Agent Financial Gateway" {
  usecase "UC05.1\nXem danh sách API key" as UC051
  usecase "UC05.2\nTạo API key" as UC052
  usecase "UC05.3\nThu hồi API key" as UC053
}

Dev -- UC051
Dev -- UC052

UC053 ..> UC051 : <<extend>>
@enduml
