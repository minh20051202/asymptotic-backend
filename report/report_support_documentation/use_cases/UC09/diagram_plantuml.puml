@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Quản trị viên\nhệ thống" as SysAdmin

rectangle "AI Agent Financial Gateway" {
  usecase "UC09.1\nXem danh mục\nmodel/provider" as UC091
  usecase "UC09.2\nThêm model/provider" as UC092
  usecase "UC09.3\nCập nhật thông tin\nmodel/provider" as UC093
  usecase "UC09.4\nVô hiệu hóa model" as UC094
  usecase "UC09.5\nCập nhật biểu giá" as UC095
  usecase "UC09.6\nThiết lập chính sách\nfallback" as UC096
}

SysAdmin -- UC091
SysAdmin -- UC092

UC093 ..> UC091 : <<extend>>
UC094 ..> UC091 : <<extend>>
UC095 ..> UC091 : <<extend>>
UC096 ..> UC091 : <<extend>>
@enduml
