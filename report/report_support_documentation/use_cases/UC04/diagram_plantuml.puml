@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor "Lập trình viên" as Dev

rectangle "AI Agent Financial Gateway" {
  usecase "UC04.1\nXem thông tin tác nhân AI" as UC041
  usecase "UC04.2\nĐăng ký tác nhân AI" as UC042
  usecase "UC04.3\nThiết lập hạn mức\ntác nhân AI" as UC043
  usecase "UC04.4\nCập nhật chu kỳ\nngân sách" as UC044
  usecase "UC04.5\nTạm dừng tác nhân AI" as UC045
}

Dev -- UC042
Dev -- UC043
Dev -- UC044

UC043 ..> UC041 : <<include>>
UC044 ..> UC041 : <<include>>
UC045 ..> UC041 : <<extend>>
@enduml
