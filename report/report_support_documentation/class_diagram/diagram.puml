@startuml
!theme plain

title Biểu đồ lớp phân tích tổng quát - Asymptotic

top to bottom direction
hide circle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 44
skinparam defaultFontName "Arial"
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

package "Lớp biên (Boundary)" as Boundary #E0F2FE {
  class "GatewayRequestBoundary" as GatewayBoundary <<boundary>> {
    +Tiếp nhận request AI
    +Trả response/stream
  }

  class "OrganizationAdminBoundary" as OrgAdminBoundary <<boundary>> {
    +Quản lý Agent/API key
    +Nạp tiền
    +Phân bổ ngân sách
  }

  class "SystemAdminBoundary" as SysAdminBoundary <<boundary>> {
    +Quản lý provider/model
    +Cập nhật biểu giá
  }

  class "PaymentCallbackBoundary" as PaymentCallback <<boundary>> {
    +Nhận kết quả thanh toán
  }

  class "AIProviderBoundary" as ProviderBoundary <<boundary>> {
    +Gọi AI Provider
    +Nhận usage metadata
  }

  class "ReportingBoundary" as ReportingBoundary <<boundary>> {
    +Xem usage/cost/trace
  }
}

package "Lớp điều khiển (Control)" as Control #FEF3C7 {
  class "AIRequestControl" as AIRequestControl <<control>> {
    +Điều phối UC01
  }

  class "AuthenticationControl" as AuthControl <<control>> {
    +Xác thực API key
  }

  class "IdempotencyControl" as IdemControl <<control>> {
    +Kiểm tra lũy đẳng
  }

  class "BudgetControl" as BudgetControl <<control>> {
    +Kiểm tra policy/budget
    +Tạm giữ ngân sách
  }

  class "RoutingControl" as RoutingControl <<control>> {
    +Chọn model/provider
    +Áp dụng fallback
  }

  class "SettlementControl" as SettlementControl <<control>> {
    +Quyết toán chi phí
  }

  class "AgentAccessControl" as AgentAccessControl <<control>> {
    +Đăng ký Agent
    +Quản lý API key
  }

  class "PaymentControl" as PaymentControl <<control>> {
    +Khởi tạo top-up
    +Xác thực thanh toán
  }

  class "BudgetAllocationControl" as BudgetAllocControl <<control>> {
    +Phân bổ/thu hồi ngân sách
  }

  class "ReportingControl" as ReportingControl <<control>> {
    +Tổng hợp usage/cost/trace
  }

  class "ProviderCatalogControl" as CatalogControl <<control>> {
    +Quản lý model/provider/price
  }
}

package "Lớp thực thể (Entity)" as Entity #DCFCE7 {
  class "Organization" as Organization <<entity>> {
    +organizationId
    +name
    +status
  }

  class "User" as User <<entity>> {
    +userId
    +email
    +role
  }

  class "DeveloperProfile" as Developer <<entity>> {
    +developerId
    +status
  }

  class "Agent" as Agent <<entity>> {
    +agentId
    +name
    +status
  }

  class "APIKey" as APIKey <<entity>> {
    +keyHash
    +status
  }

  class "Wallet" as Wallet <<entity>> {
    +balance
    +reservedBalance
  }

  class "BudgetPolicy" as BudgetPolicy <<entity>> {
    +limitAmount
    +period
    +spentAmount
  }

  class "AIProvider" as AIProvider <<entity>> {
    +providerId
    +name
    +status
  }

  class "AIModel" as AIModel <<entity>> {
    +modelId
    +name
    +status
  }

  class "PricingPolicy" as Pricing <<entity>> {
    +unitPrice
    +effectiveFrom
  }

  class "FinancialTransaction" as Transaction <<entity>> {
    +transactionId
    +status
    +amount
  }

  class "LedgerEntry" as Ledger <<entity>> {
    +entryType
    +amount
  }

  class "PaymentTransaction" as PaymentTx <<entity>> {
    +providerReference
    +status
  }

  class "IdempotencyRecord" as IdemRecord <<entity>> {
    +idempotencyKey
    +requestHash
  }

  class "ExecutionTrace" as Trace <<entity>> {
    +traceId
    +usage
    +cost
  }
}

GatewayBoundary --> AIRequestControl
OrgAdminBoundary --> PaymentControl
OrgAdminBoundary --> BudgetAllocControl
OrgAdminBoundary --> AgentAccessControl
ReportingBoundary --> ReportingControl
SysAdminBoundary --> CatalogControl
PaymentCallback --> PaymentControl

AIRequestControl --> AuthControl
AIRequestControl --> IdemControl
AIRequestControl --> BudgetControl
AIRequestControl --> RoutingControl
AIRequestControl --> ProviderBoundary
AIRequestControl --> SettlementControl

AuthControl --> APIKey
IdemControl --> IdemRecord
BudgetControl --> Wallet
BudgetControl --> BudgetPolicy
RoutingControl --> AIProvider
RoutingControl --> AIModel
SettlementControl --> Transaction
SettlementControl --> Ledger
SettlementControl --> Trace

AgentAccessControl --> Organization
AgentAccessControl --> Agent
AgentAccessControl --> APIKey
PaymentControl --> PaymentTx
PaymentControl --> Wallet
BudgetAllocControl --> Wallet
BudgetAllocControl --> BudgetPolicy
BudgetAllocControl --> Developer
ReportingControl --> Transaction
ReportingControl --> Trace
CatalogControl --> AIProvider
CatalogControl --> AIModel
CatalogControl --> Pricing

Organization "1" *-- "1" Wallet
Organization "1" *-- "0..*" User
Organization "1" *-- "0..*" Developer
Organization "1" *-- "0..*" Agent
User "1" o-- "0..1" Developer
Developer "1" o-- "0..*" Agent
Agent "1" *-- "0..*" APIKey
Agent "1" o-- "0..*" BudgetPolicy
AIProvider "1" *-- "0..*" AIModel
AIModel "1" o-- "1..*" Pricing
Transaction "1" *-- "1..*" Ledger
Transaction "0..1" o-- "1" Trace
Transaction "0..1" o-- "1" IdemRecord
PaymentTx "1" o-- "0..1" Transaction

@enduml
