@startuml
!theme plain

title Sequence UC01 - Thực hiện yêu cầu AI qua Gateway

autonumber
skinparam shadowing false
skinparam defaultFontName "Arial"

actor "AI Agent" as Agent
participant "GatewayHandler" as Handler
participant "AIRequestService" as Service
participant "APIKeyService" as KeyService
participant "IdempotencyService" as Idem
participant "PolicyService" as Policy
participant "BudgetReservationService" as Budget
participant "ProviderRouter" as Router
participant "ProviderAdapter" as Adapter
participant "AI Provider" as Provider
participant "SettlementService" as Settlement
participant "TraceService" as Trace

Agent -> Handler: gửi request AI với Asymptotic API key
Handler -> Service: executeRequest(request)
Service -> KeyService: authenticate(apiKey)

alt API key không hợp lệ
  KeyService --> Service: lỗi xác thực
  Service --> Handler: từ chối request
  Handler --> Agent: 401/403
else API key hợp lệ
  KeyService --> Service: Agent + Organization
  Service -> Idem: check(idempotencyKey, requestHash)

  alt request đã xử lý
    Idem --> Service: kết quả đã lưu
    Service --> Handler: replay response
    Handler --> Agent: trả kết quả không tính phí trùng
  else request mới
    Service -> Policy: validatePolicy(agent, model, scope)
    Service -> Budget: reserveBudget(agent, estimatedCost)

    alt vi phạm policy hoặc không đủ ngân sách
      Budget --> Service: từ chối
      Service -> Trace: recordRejected()
      Service --> Handler: lỗi nghiệp vụ
      Handler --> Agent: 402/429/403
    else đủ điều kiện
      Service -> Router: selectProvider(model, policy)
      Router --> Service: provider + model
      Service -> Adapter: sendRequest(payload, internalCredential)
      Adapter -> Provider: gọi AI Provider
      Provider --> Adapter: response + usage metadata
      Adapter --> Service: normalized response
      Service -> Settlement: settleUsage(actualUsage, actualCost)
      Service -> Trace: recordCompleted()
      Service -> Idem: storeResult()
      Service --> Handler: response
      Handler --> Agent: kết quả AI
    end
  end
end

@enduml
